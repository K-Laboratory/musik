# ---------------------------------------------------------------------------
# Favorite Songs - environment variables
#
# Copy this file to `.env.local` for local development:
#   cp .env.local.example .env.local
# and fill in the values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" public API key (safe to expose to the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# YouTube Data API v3 key. Server-side only - never exposed to the browser.
YOUTUBE_API_KEY=

# Admin allowlist for the /admin area. Comma-separated emails.
ADMIN_EMAILS=

# --- Emotion classification pipeline -------------------------------------
# OpenAI-compatible key used ONLY server-side to classify songs.
# Lyrics are fetched transiently and never stored.
OPENAI_API_KEY=

# Optional: chat model (default gpt-4o-mini) and API base.
CLASSIFIER_MODEL=
CLASSIFIER_API_BASE=

# Optional: lyrics provider. Defaults to LRCLIB (https://lrclib.net).
# Set LYRICS_PROVIDER=none to classify from metadata only.
LYRICS_API_BASE=
LYRICS_API_TOKEN=
LYRICS_PROVIDER=

# ---------------------------------------------------------------------------
# Favorite Songs - environment variables
#
# Copy this file to `.env.local` for local development:
#   cp .env.local.example .env.local
# and fill in the values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" public API key (safe to expose to the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# YouTube Data API v3 key. Server-side only - never exposed to the browser.
YOUTUBE_API_KEY=

# Admin allowlist for the /admin area. Comma-separated emails.
ADMIN_EMAILS=

# --- Emotion classification pipeline -------------------------------------
# API key for the classifier. Works with any OpenAI-compatible provider.
# Preferred: CLASSIFIER_API_KEY (DeepSeek, OpenAI, OpenRouter, ...).
# Back-compat: DEEPSEEK_API_KEY or OPENAI_API_KEY are also accepted.
# Lyrics are fetched transiently and never stored.
CLASSIFIER_API_KEY=
# Aliases (use one of these instead of CLASSIFIER_API_KEY if you prefer):
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional overrides. With a DeepSeek key and no explicit base, the base
# defaults to https://api.deepseek.com/v1 and the model to "deepseek-chat".
CLASSIFIER_MODEL=
CLASSIFIER_API_BASE=

# Optional: lyrics provider. Defaults to LRCLIB (https://lrclib.net), which is
# tried via exact lookup then fuzzy search. Set LYRICS_PROVIDER=none to skip
# lyrics entirely. When no lyrics are found the model classifies from its own
# knowledge of the song, so results are still useful.
LYRICS_API_BASE=
LYRICS_API_TOKEN=
LYRICS_PROVIDER=

# Optional: transient web-search fallback for lyrics that LRCLIB lacks.
# Works with Tavily or any endpoint that accepts {"query":...} + Bearer auth.
# The fetched text is used only for the prompt and never stored.
SEARCH_API_KEY=
SEARCH_API_BASE=
